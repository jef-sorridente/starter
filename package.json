{
  "name": "starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter api run test:e2e",
    "test:e2e:web": "pnpm --filter e2e run test:e2e",
    "test:ui:visual": "pnpm --filter @app/ui run test:visual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm deps:check && pnpm test",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "db:generate": "pnpm --filter api run prisma:generate",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "rename-project": "node scripts/rename-project.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.0",
    "stylelint": "^17.16.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  }
}
