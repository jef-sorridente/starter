# Só pros testes de integração (apps/api/test/*.e2e-spec.ts), contra
# o banco isolado subido via `docker compose --profile test up -d`.
# Sem segredo de verdade aqui de propósito — nunca usado fora de teste.
DATABASE_URL="postgresql://usuario:senha@localhost:5438/starter_test?schema=public"
JWT_SECRET="e2e-test-secret-nao-usar-em-producao"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN="http://localhost:3000"
WEB_URL="http://localhost:3000"
# Vazias de propósito: o ConfigModule carrega .env por baixo dos panos
# se uma chave não estiver definida aqui, e isso puxaria a API key de
# verdade do apps/api/.env — fazendo os testes chamarem o Resend de
# verdade. MailerService trata string vazia como "não configurado" e
# só loga um aviso, sem enviar nada.
RESEND_API_KEY=""
MAIL_FROM=""
