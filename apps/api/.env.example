NODE_ENV="development"
DATABASE_URL="postgresql://usuario:senha@localhost:5437/starter?schema=public"
PORT=3001
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Origens permitidas por CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:3000"
# Obrigatório se NODE_ENV=production (a API não sobe sem isso em produção)
RESEND_API_KEY=""
MAIL_FROM=""
# Base do frontend, usada para montar os links de verificação de
# e-mail e redefinição de senha enviados por e-mail
WEB_URL="http://localhost:3000"
# fatal | error | warn | info | debug | trace | silent
# (default: debug em dev, info em produção, silent em teste)
LOG_LEVEL=""
# Só "false" em teste automatizado — a API recusa subir assim em produção
RATE_LIMIT_ENABLED="true"
